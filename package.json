{
  "name": "dramaflash",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --watch=false --watchman=false",
    "test:coverage": "jest --coverage --runInBand --watchman=false",
    "verify": "npm run check:language && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
    "check:language": "node scripts/check-language.cjs",
    "sonar:local": "node scripts/check-sonar.cjs",
    "qa": "npm run verify && npm run sonar:local"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.16",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.14",
    "expo-asset": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-font": "58.0.8",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-video": "58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "eslint-plugin-react-perf": "3.3.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
